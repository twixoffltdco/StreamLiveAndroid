<?xml version="1.0" encoding="utf-8"?>
<!--
    Иконка AndroidX Splash Screen: логотип StreamLive на чёрном фоне.
    Сплайны вектора масштабируются системой в круг сплэша автоматически.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Кольцо эфира -->
    <path
        android:pathData="M54,54m-34,0a34,34 0,1 1,68 0a34,34 0,1 1,-68 0"
        android:strokeWidth="5"
        android:strokeColor="#00F2EA"
        android:fillColor="#00000000" />

    <!-- Play-треугольник в градиенте бренда -->
    <path android:pathData="M44,36 L44,72 L76,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="44" android:startY="36"
                android:endX="76" android:endY="72"
                android:type="linear">
                <item android:offset="0.0" android:color="#00F2EA" />
                <item android:offset="1.0" android:color="#FE2C55" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
